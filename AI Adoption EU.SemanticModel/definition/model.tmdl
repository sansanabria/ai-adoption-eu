model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","# Measures","AIAdoptionTrendEU","AIAdoptionByCountry","AIAdoptionByEnterpriseSize","AIAdoptionByBusinessFunction","AIAdoptionBySector","GenAIUseByCountry","AIAdoptionByOccupation","AIAdoptionByEducation","AIAdoptionOverallEU"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table '# Measures'
ref table AIAdoptionTrendEU
ref table AIAdoptionByCountry
ref table AIAdoptionByEnterpriseSize
ref table AIAdoptionByBusinessFunction
ref table AIAdoptionBySector
ref table GenAIUseByCountry
ref table AIAdoptionByOccupation
ref table AIAdoptionByEducation
ref table AIAdoptionOverallEU

ref cultureInfo en-US

